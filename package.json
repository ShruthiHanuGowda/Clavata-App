{
  "name": "dwallet",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "log": "react-native log-android",
    "android:dwallet": "ENVFILE=.env.dwallet react-native run-android",
    "android:testnet": "ENVFILE=.env.dwallet.testnet react-native run-android",
    "ios": "react-native run-ios --scheme DWallet",
    "ios:dwallet": "react-native run-ios --scheme DWallet",
    "ios:testnet": "react-native run-ios --scheme \"DWallet copy\"",
    "lint": "eslint .",
    "start": "react-native start --reset-cache",
    "start:dwallet": "ENVFILE=.env.dwallet react-native start --reset-cache",
    "start:testnet": "ENVFILE=.env.dwallet.testnet react-native start --reset-cache",
    "test": "jest",
    "pods:install": "cd ios && pod install && cd .."
  },
